# ══════════════════════════════════════════════════════════════
#  Login API - Environment Configuration Template
# ══════════════════════════════════════════════════════════════

# ── AWS Secrets Manager Configuration (Centralized) ──────────
# Define these to dynamically retrieve database credentials from AWS Secrets Manager
AWS_REGION=us-east-1
AWS_SECRETS_NAME=eval3-rds-credentials
RDS_STACK_NAME=login-app-rds

# ── Local Development / Direct Configuration (Optional) ──────
# Uncomment and configure these only if you are running locally without AWS
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logindb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# POSTGRES_DB=logindb
